# domain plug-in: generic (default) | retail (example) | <yours, from scripts/new_domain.py>
DOMAIN=generic
SUBJECT_HEADER=X-Customer-Id
# Supabase: Project Settings > Database > Connection string > Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# tests + offline eval TRUNCATE tables: point at a throwaway DB, never production (default: compose `db`)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Qdrant Cloud cluster
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=docs
# LLM + embeddings (Gemini via its OpenAI-compatible endpoint)
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-latest
EMBED_MODEL=gemini-embedding-001
MOCK_LLM=false
# retrieval
EMBED_BACKEND=api
TOP_K=6
CHUNK_CHARS=900
CHUNK_OVERLAP=150
MIN_RELEVANCE=0.30
ADMIN_KEY=change-me
