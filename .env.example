# domain plug-in: generic (default) | retail (example) | <yours, from scripts/new_domain.py>
DOMAIN=engage
SUBJECT_HEADER=X-Customer-Id
# Supabase: Project Settings > Database > Connection string > Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# tests + offline eval TRUNCATE tables: point at a throwaway DB, never production (default: compose `db`)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# LLM + embeddings (Gemini via its OpenAI-compatible endpoint)
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-latest
MOCK_LLM=false
ADMIN_KEY=change-me
