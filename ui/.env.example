# "http" (default) calls the real backend through /api (see vite.config.ts proxy).
# "mock" uses the in-browser synthetic data in src/data/mock.ts (no backend needed).
VITE_DATA_SOURCE=http

# Where the dev server forwards /api requests when VITE_DATA_SOURCE=http
VITE_BACKEND_URL=http://localhost:8000

# Same value as ADMIN_KEY in the repo-root .env (the dev proxy adds it as X-Admin-Key; never in the bundle)
ADMIN_KEY=
