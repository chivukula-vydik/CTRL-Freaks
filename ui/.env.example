# "mock" uses the in-browser synthetic data in src/data/mock.ts (no backend needed).
# "http" calls the real backend through /api (see vite.config.ts proxy).
VITE_DATA_SOURCE=mock

# Where the dev server forwards /api requests when VITE_DATA_SOURCE=http
VITE_BACKEND_URL=http://localhost:8000

# Same value as ADMIN_KEY in hcl-rag-agent/.env (dev proxy adds it as X-Admin-Key)
ADMIN_KEY=
